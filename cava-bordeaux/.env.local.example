# Copiar a .env.local y completar con las claves reales.
# .env.local nunca se sube al repositorio (ver .gitignore).

# --- Firebase (Firestore: catálogo/pedidos/newsletter, Auth: cuentas cliente) ---
# Sin estas variables, el sitio funciona en modo demo con lib/products.ts
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Stripe (se agrega en la fase de checkout, aún no usado) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
