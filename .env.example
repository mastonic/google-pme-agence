# Local Pulse — exemple de configuration (AUCUN secret réel ici)

# ── Admin privé ────────────────────────────────────────────────
# Même OAuth Client ID côté frontend et backend.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Liste autorisée côté SERVEUR uniquement. Ne jamais mettre ces emails dans le frontend.
ADMIN_EMAILS=admin1@example.com,admin2@example.com
ADMIN_AUTH_REQUIRED=true

# ── Base de données ────────────────────────────────────────────
# Production recommandée : PostgreSQL / Cloud SQL / autre SQL persistant.
DATABASE_URL=postgresql://user:password@host:5432/local_pulse
# Passe à true en production pour empêcher tout démarrage accidentel sur SQLite éphémère.
REQUIRE_PERSISTENT_DB=true

# ── URL publique ───────────────────────────────────────────────
PUBLIC_APP_URL=https://your-domain.example

# ── Sources & IA ───────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
APIFY_API_TOKEN=
PAPPERS_API_KEY=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
GEMINI_API_KEY=
MISTRAL_API_KEY=
FAL_KEY=
VERCEL_API_TOKEN=

# ── Paiement ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Supervision ────────────────────────────────────────────────
MONITOR_SCHEDULE_ENABLED=true
MONITOR_HOUR=8
MONITOR_WINDOW_MINUTES=45
MONITOR_TZ=Europe/Paris

# Audit automatique après scan
AUTO_AUDIT_ENABLED=true
AUTO_AUDIT_TOP_N=5
