# ─── Local-Pulse — variables d'environnement ─────────────────────────────────
# Copie ce fichier :   cp .env.example .env   puis remplis les valeurs.
# .env est ignoré par git : ne commite jamais tes vraies clés.
# deploy.sh pousse chaque valeur non vide dans Google Secret Manager.
# Une clé laissée vide ici garde la version déjà stockée dans Secret Manager.

# ── Obligatoire ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── IA / LLM ─────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
FAL_API_KEY=

# ── Données / médias ─────────────────────────────────────────────────────────
PAPPERS_API_KEY=
PEXELS_API_KEY=
APIFY_TOKEN=
VERCEL_API_TOKEN=

# ── Paiement ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Base de données / admin ──────────────────────────────────────────────────
DATABASE_URL=
ADMIN_API_TOKEN=

# ── Email (SMTP IONOS) — voir docs/email/IONOS_CONFIGURATION.md ─────────────
# Boîte d'envoi authentifiée (compte IONOS) : contact@pulse-locale-pme.fr.
# Serveur et port : à vérifier dans l'espace IONOS (Email > Paramètres de la boîte).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=ssl            # ssl (port 465) ou starttls (port 587)
SMTP_USER=contact@pulse-locale-pme.fr
SMTP_PASSWORD=
SMTP_FROM=contact@pulse-locale-pme.fr
# Autres expéditeurs autorisés (même domaine, vérifiés chez IONOS), séparés par des virgules :
SMTP_ALLOWED_FROM=
ALERT_EMAIL=
# Boîtes de destination (valeurs par défaut ci-dessous, à ne changer que si besoin) :
EMAIL_CONTACT=contact@pulse-locale-pme.fr
EMAIL_DEVIS=devis@pulse-locale-pme.fr
EMAIL_COMMANDES=commandes@pulse-locale-pme.fr
EMAIL_SUPPORT=support@pulse-locale-pme.fr
EMAIL_AUDIT=audit@pulse-locale-pme.fr

# ── Twilio (Réceptionniste IA / WhatsApp) ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ── Configuration non sensible (variables Cloud Run) ─────────────────────────
PERPLEXITY_MODEL=
MONITOR_TZ=Europe/Paris
FRONTEND_URL=
